<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Midgudr · Realm Charter</title>

  <style>
    @import url("https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800&family=Rajdhani:wght@400;600;700&display=swap");

    :root {
      --bg: #08090e;
      --panel: #14131d;
      --gold: #d4b46a;
      --cyan: #8deaff;
      --text: #eee9de;
      --muted: #bbb6c3;
      --border: #55452d;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      color: var(--text);
      background:
        radial-gradient(ellipse at top, #48223966, transparent 60%),
        var(--bg);
      font: 19px/1.8 "Rajdhani", sans-serif;
    }

    header {
      padding: 22px 6%;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
    }

    .brand, h1, h2, h3 {
      font-family: Algerian, "Cinzel", Georgia, serif;
      color: var(--gold);
    }

    .brand {
      text-decoration: none;
      font-size: 24px;
      letter-spacing: 4px;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 22px;
    }

    nav a {
      color: var(--text);
      text-decoration: none;
      font-size: 14px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .hero {
      padding: 110px 24px;
      text-align: center;
      border-bottom: 1px solid var(--border);
      background:
        radial-gradient(circle, #d4b46a0c, transparent 65%);
    }

    .eyebrow {
      color: var(--cyan);
      text-transform: uppercase;
      letter-spacing: 4px;
      font-size: 13px;
      font-weight: 700;
    }

    h1 {
      font-size: clamp(48px, 10vw, 100px);
      line-height: 1.15;
      letter-spacing: 5px;
      margin: 25px 0;
    }

    .hero p {
      max-width: 720px;
      margin: 20px auto;
      font-size: 23px;
      color: var(--muted);
    }

    .button {
      display: inline-block;
      margin-top: 20px;
      padding: 12px 25px;
      border: 1px solid var(--cyan);
      background: #8deaff0a;
      color: var(--cyan);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 700;
    }

    .section {
      max-width: 1150px;
      margin: auto;
      padding: 75px 24px;
    }

    h2 {
      font-size: clamp(30px, 5vw, 44px);
      line-height: 1.3;
    }

    h3 {
      font-size: 23px;
      line-height: 1.4;
    }

    p { color: var(--muted); }

    .declaration {
      padding: 35px;
      border: 1px solid var(--border);
      border-left: 4px solid var(--gold);
      background: linear-gradient(135deg, #291b28, #11131e);
    }

    .declaration p {
      color: var(--text);
      font-size: 22px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
      margin-top: 35px;
    }

    article {
      padding: 28px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-top: 2px solid var(--gold);
    }

    .number {
      color: var(--cyan);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 3px;
    }

    .oath {
      text-align: center;
      padding: 65px 25px;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      background: #17121d;
    }

    .oath blockquote {
      max-width: 850px;
      margin: 25px auto;
      color: var(--gold);
      font: 27px/1.7 "Cinzel", Georgia, serif;
    }

    footer {
      padding: 30px 24px;
      text-align: center;
      color: var(--muted);
      font-size: 14px;
    }

    :focus-visible {
      outline: 3px solid var(--cyan);
      outline-offset: 5px;
    }

    @media (max-width: 760px) {
      header {
        flex-direction: column;
        align-items: flex-start;
      }

      .grid { grid-template-columns: 1fr; }
      .hero { padding: 70px 24px; }
      .declaration { padding: 24px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
    }
  </style>
</head>

<body>
  <header>
    <a class="brand" href="#">MIDGUDR</a>
    <nav aria-label="Main navigation">
      <a href="#charter">Declaration</a>
      <a href="#axioms">Realm axioms</a>
      <a href="#oath">Our oath</a>
    </nav>
  </header>

  <main>
